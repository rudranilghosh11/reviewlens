# ReviewLens V2 — Environment Variables
# Copy this file to .env and fill in values as needed.

# Maximum upload size in megabytes (default 250 MB = 262,144,000 bytes)
MAX_UPLOAD_SIZE_MB=250

# Alternatively, set exact byte limit:
# MAX_UPLOAD_BYTES=262144000

# Maximum rows to analyse (default 20000)
MAX_ANALYSIS_ROWS=20000

# OCR Configuration: Optional custom path to Tesseract OCR binary if not on PATH
# e.g.: C:\Program Files\Tesseract-OCR\tesseract.exe
# If unset, ReviewLens auto-discovers Tesseract on PATH or falls back to Windows native OCR.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: Anthropic API key for LLM-based aspect extraction
# ANTHROPIC_API_KEY=sk-ant-...

# Frontend origin for CORS
FRONTEND_ORIGIN=http://localhost:5173
